{
  "name": "astreintes",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "docs:types": "node scripts/generate-type-catalog.cjs",
    "dev": "ng serve",
    "start:4300": "ng serve --port 4300",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",

    "test": "npm run test:jest && npm run test:rh-exports",
    "test:all": "npm run test:db-tests && npm run test:jest && npm run test:rh-exports",

    "test:db-tests" : "npm run test:db-schema && npm run test:db-user-roles",
    "test:db-schema": "node scripts/test-schema.cjs",
    "test:db-user-roles": "node scripts/test-user-roles.cjs",
    
    
    "test:rh-exports": "npm run test:rh-calculations && npm run test:rh-interventions && npm run test:rh-excel && npm run test:rh-period-excel",
    "test:rh-calculations": "tsc -p tsconfig.rh-export-tests.json && node out-tsc/rh-export-tests/pages/rh/export-libraries/rh-export-calculations.spec.js",
    "test:rh-interventions": "tsc -p tsconfig.rh-export-tests.json && node out-tsc/rh-export-tests/pages/rh/export-libraries/rh-intervention-calculations.spec.js",
    "test:rh-excel": "jest --runInBand --runTestsByPath src/app/pages/rh/export-libraries/rh-excel-export.lib.jest-spec.ts",
    "test:rh-period-excel": "jest --runInBand --runTestsByPath src/app/pages/rh/export-libraries/rh-period-excel-export.lib.jest-spec.ts src/app/pages/rh/rh-period-exports.component.jest-spec.ts",
    
    
    "test:jest": "jest --runInBand",
    "test:jest:coverage": "jest --coverage --runInBand",

    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose up -d --build"
  },
  "dependencies": {
    "@angular/animations": "20.3.33",
    "@angular/cdk": "20.2.14",
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "@angular/platform-browser-dynamic": "20.3.33",
    "@angular/router": "20.3.33",
    "@ngrx/effects": "20.1.0",
    "@ngrx/store": "20.1.0",
    "@primeuix/themes": "^3.0.0",
    "@supabase/supabase-js": "^2.110.8",
    "exceljs": "4.4.0",
    "primeicons": "^8.0.0",
    "primeng": "20.4.0",
    "rxjs": "~7.8.1",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "20.3.39",
    "@angular/cli": "22.2.3",
    "@angular/compiler-cli": "20.3.33",
    "@types/jest": "^30.0.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "jest-preset-angular": "^15.0.3",
    "supabase": "^2.109.1",
    "ts-jest": "^29.4.11",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "postcss": "8.5.23",
    "@hono/node-server": "2.0.12",
    "glob": "13.0.6",
    "minimatch": "10.2.5",
    "brace-expansion": "5.0.12",
    "test-exclude": "8.0.0",
    "uuid": "14.0.1",
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "4.3.2"
    }
  }
}
